[{"en":"Only here am I free…","o":"Tantum hic li——ber sum…","album":"Atramentum Custodit","song":"The Wood Keeps Answering","url":"songs/atramentum-custodit/01-the-wood-keeps-answering.html"},{"en":"The ink remains.","o":"Τὸ μέλαν μένει.","album":"Atramentum Custodit","song":"The Wood Keeps Answering","url":"songs/atramentum-custodit/01-the-wood-keeps-answering.html"},{"en":"The red dance passes; my foot stays.","o":"Rubra saltatio transit; pes meus manet.","album":"Atramentum Custodit","song":"The Wood Keeps Answering","url":"songs/atramentum-custodit/01-the-wood-keeps-answering.html"},{"en":"The heart is open.","o":"Hṛdayaṃ vivṛtam.","album":"Atramentum Custodit","song":"Ante Acum","url":"songs/atramentum-custodit/02-ante-acum.html"},{"en":"The lamp comes down; the shadow falls to the elbow.","o":"Lucerna descendit; umbra ad cubitum cadit.","album":"Atramentum Custodit","song":"Sub Lucerna","url":"songs/atramentum-custodit/03-sub-lucerna.html"},{"en":"The mark guards the body.","o":"Signum corpus custodit.","album":"Atramentum Custodit","song":"Signa Corporis","url":"songs/atramentum-custodit/05-signa-corporis.html"},{"en":"The wing is mine; the sky is not mine.","o":"Крило моѥ; небо не моѥ.","album":"Atramentum Custodit","song":"Ala Sub Cute","url":"songs/atramentum-custodit/06-ala-sub-cute.html"},{"en":"Who is speaking, if my mouth is shut?","o":"Quis loquitur, si os meum clausum est?","album":"Atramentum Custodit","song":"Ala Sub Cute","url":"songs/atramentum-custodit/06-ala-sub-cute.html"},{"en":"Onward through ash.","o":"","album":"Chair Cuts","song":"Ultrafin","url":"songs/chair-cuts/01-ultrafin.html"},{"en":"He palms the light. He hides the door.","o":"","album":"Decima Signata","song":"Praestigiator","url":"songs/decima-signata/01-praestigiator.html"},{"en":"She told me wait. She told me breathe.","o":"","album":"Decima Signata","song":"Temperantia","url":"songs/decima-signata/02-temperantia.html"},{"en":"She held. And holding has no name.","o":"","album":"Decima Signata","song":"Vis","url":"songs/decima-signata/03-vis.html"},{"en":"The sky is a floor. The floor is beneath.","o":"","album":"Decima Signata","song":"Suspensus","url":"songs/decima-signata/04-suspensus.html"},{"en":"Look up. It's already gone.","o":"","album":"Decima Signata","song":"Stella","url":"songs/decima-signata/05-stella.html"},{"en":"Count the floors. Then forget them.","o":"","album":"Decima Signata","song":"Turris","url":"songs/decima-signata/06-turris.html"},{"en":"I am the world. You are the song.","o":"","album":"Decima Signata","song":"Mundus","url":"songs/decima-signata/07-mundus.html"},{"en":"No number. No floor. No fear.","o":"","album":"Decima Signata","song":"Stultus","url":"songs/decima-signata/08-stultus.html"},{"en":"The lid is not the end.","o":"","album":"Decima Signata","song":"Iudicium","url":"songs/decima-signata/09-iudicium.html"},{"en":"The silence is true.","o":"Silentium verum est.","album":"Deus Fabricatus","song":"Deus Tacet (Live)","url":"songs/deus-fabricatus/09-deus-tacet-live.html"},{"en":"I know. And I keep silent.","o":"Scio. Et taceo.","album":"Deus Fabricatus","song":"Sacerdos (Live)","url":"songs/deus-fabricatus/11-sacerdos-live.html"},{"en":"I doubted. I kept silent.","o":"Dubitavi. Tacui.","album":"Deus Fabricatus","song":"Sanctum (Live)","url":"songs/deus-fabricatus/03-sanctum-live.html"},{"en":"Play. (We play.)","o":"Ludite. (Ludimus.)","album":"Deus Fabricatus","song":"Ludus Vitae (Live)","url":"songs/deus-fabricatus/08-ludus-vitae-live.html"},{"en":"The mountain does not ask. It states.","o":"","album":"He Goes to the Priest","song":"The First Law","url":"songs/he-goes-to-the-priest/01-the-first-law.html"},{"en":"Air thins because height takes it.","o":"","album":"He Goes to the Priest","song":"The First Law","url":"songs/he-goes-to-the-priest/01-the-first-law.html"},{"en":"The valley watches and cannot follow.","o":"","album":"He Goes to the Priest","song":"The Leaving","url":"songs/he-goes-to-the-priest/02-the-leaving.html"},{"en":"Under the ribs. Not in the sky.","o":"","album":"He Goes to the Priest","song":"Where the Weight Lands","url":"songs/he-goes-to-the-priest/03-where-the-weight-lands.html"},{"en":"And received what lasts longer.","o":"","album":"He Goes to the Priest","song":"What He Keeps","url":"songs/he-goes-to-the-priest/06-what-he-keeps.html"},{"en":"Soft things stack. Stone does not.","o":"","album":"He Goes to the Priest","song":"Blessed Things","url":"songs/he-goes-to-the-priest/09-blessed-things.html"},{"en":"I dance, I turn in place.","o":"nee-nee-to-TEE-a, nee-no-ma-la-ka-CHOH-a","album":"Mochipa","song":"Atezcatl","url":"songs/mochipa/05-atezcatl.html"},{"en":"Come here, close to me.","o":"shee-WAHL-lowh no-NAH-wak","album":"Mochipa","song":"Xictlapo","url":"songs/mochipa/03-xictlapo.html"},{"en":"Everywhere… everywhere.","o":"no-WEE-yahn... no-WEE-yahn","album":"Mochipa","song":"Nohuiyan","url":"songs/mochipa/07-nohuiyan.html"},{"en":"We will not go.","o":"AH-mo tee-YAHS-keh","album":"Mochipa","song":"Ximolini","url":"songs/mochipa/08-ximolini.html"},{"en":"Like a lamp without oil!","o":"Snai shmereh, ramtmakteh tsok.","album":"She Dances the Sun Down","song":"Like a Lamp Without Oil","url":"songs/she-dances-the-sun-down/03-like-a-lamp-without-oil.html"},{"en":"Light a lamp, light a lamp.","o":"Tsok tengsaa, tsok tengsaa.","album":"She Dances the Sun Down","song":"Like a Lamp Without Oil","url":"songs/she-dances-the-sun-down/03-like-a-lamp-without-oil.html"},{"en":"Heart… heart…","o":"sair... sair...","album":"She Who Stays","song":"In the Dark Alone","url":"songs/she-who-stays/05-in-the-dark-alone.html"},{"en":"Little one… little one…","o":"nə-djes... nə-djes...","album":"She Who Stays","song":"The Three Faces Answer","url":"songs/she-who-stays/03-the-three-faces-answer.html"},{"en":"May sweet sleep calm you…","o":"lee-NEEKH-ka sheetooTAHboo...","album":"So May He Rest","song":"Run From the House","url":"songs/so-may-he-rest/11-run-from-the-house.html"},{"en":"the grain of this sorrow…","o":"THIS-seh SOR-yeh KORN.","album":"So May He Rest","song":"Black Wool","url":"songs/so-may-he-rest/05-black-wool.html"},{"en":"Whistle… whistle…","o":"KHWIT... KHWIT...","album":"So May He Rest","song":"Unless It Had Strong Wings","url":"songs/so-may-he-rest/07-unless-it-had-strong-wings.html"},{"en":"The lie falls. The rite stays.","o":"Pseudos falls. Telete stays.","album":"Soft God Is the Lie","song":"If He Survives","url":"songs/soft-god-is-the-lie/02-if-he-survives.html"},{"en":"Bones — soft now. Blood — memory.","o":"Ossa — soft now. Cruor — memory.","album":"Soft God Is the Lie","song":"The Quiet Held","url":"songs/soft-god-is-the-lie/06-the-quiet-held.html"},{"en":"The lie burns. Iron stays.","o":"Pseudos burns. Iron stays.","album":"Soft God Is the Lie","song":"Come Bloody","url":"songs/soft-god-is-the-lie/03-come-bloody.html"},{"en":"Nobody comes back the same.","o":"Nemo redit idem.","album":"The Angel Over the Chair","song":"The Drawer of Tracings","url":"songs/the-angel-over-the-chair/03-the-drawer-of-tracings.html"},{"en":"My skin remembers.","o":"הָעוֹר זוֹכֵר","album":"The Angel Over the Chair","song":"The Seventh Night of the Mark","url":"songs/the-angel-over-the-chair/04-the-seventh-night-of-the-mark.html"},{"en":"The silence reads him.","o":"Silentium legit.","album":"The Angel Over the Chair","song":"The Hour Without Words","url":"songs/the-angel-over-the-chair/06-the-hour-without-words.html"},{"en":"We read each other in the quiet.","o":"Legimus in tacendo.","album":"The Angel Over the Chair","song":"The Hour Without Words","url":"songs/the-angel-over-the-chair/06-the-hour-without-words.html"},{"en":"No other hand.","o":"οὐδεμία ἄλλη χείρ.","album":"The Angel Over the Chair","song":"The Last Open Day","url":"songs/the-angel-over-the-chair/05-the-last-open-day.html"},{"en":"She said nothing is gone, only covered","o":"","album":"The Angel Over the Chair","song":"What the Black Covers","url":"songs/the-angel-over-the-chair/08-what-the-black-covers.html"},{"en":"I said nothing, and you heard all of it","o":"","album":"The Angel Over the Chair","song":"The Hour Without Words","url":"songs/the-angel-over-the-chair/06-the-hour-without-words.html"},{"en":"It will not leave, it was not made for leaving","o":"","album":"The Angel Over the Chair","song":"The Butterfly on the Nape","url":"songs/the-angel-over-the-chair/07-the-butterfly-on-the-nape.html"},{"en":"The scar is close — close only.","o":"Cicatrix is close — close only.","album":"The Face-Down","song":"Bres","url":"songs/the-face-down/03-bres.html"},{"en":"Refuse. Hold fast. Still here. Still carrying.","o":"Nyöjhkedh. Steededh. Still here. Still carrying.","album":"The Face-Down","song":"Carry the Dead","url":"songs/the-face-down/04-carry-the-dead.html"},{"en":"III. Empress. Throne.","o":"III. Imperatrix. Solium.","album":"The Face-Down","song":"The Empress","url":"songs/the-face-down/05-the-empress.html"},{"en":"As I circle the lake of drinks","o":"ah-NEE-gin-eh————","album":"The Unreturning","song":"The Lake of Drinks","url":"songs/the-unreturning/02-the-lake-of-drinks.html"},{"en":"The fire burns.","o":"Ignis ardet.","album":"What the Fire Kept","song":"Triumpe","url":"songs/what-the-fire-kept/01-triumpe.html"},{"en":"The drums are beating.","o":"Tympana pulsant.","album":"What the Fire Kept","song":"Triumpe","url":"songs/what-the-fire-kept/01-triumpe.html"},{"en":"Tireless fire.","o":"Pyr akamaton.","album":"What the Fire Kept","song":"Triumpe","url":"songs/what-the-fire-kept/01-triumpe.html"},{"en":"The dance! The dance!","o":"Tripudium! Tripudium!","album":"What the Fire Kept","song":"Triumpe","url":"songs/what-the-fire-kept/01-triumpe.html"},{"en":"When the day dawns…","o":"U4 zal-la...","album":"What the Fire Kept","song":"Linkueni","url":"songs/what-the-fire-kept/05-linkueni.html"}]